{
  "buildCommand": "npm run build",
  "functions": {
    "api/notion.js": {
      "maxDuration": 10
    },
    "api/metadata.js": {
      "maxDuration": 5
    },
    "api/contact.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/notion",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/metadata",
      "headers": [
        {
          "key": "Cache-Control", 
          "value": "s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static-loader-data-manifest-(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifestInfo.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/static-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/in/harmanpunn/",
      "permanent": true
    },
    {
      "source": "/github",
      "destination": "https://github.com/harmanpunn",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.linkedin.com/in/harmanpunn/",
      "has": [
        {
          "type": "host",
          "value": "linkedin.harmanpunn.me"
        }
      ],
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://github.com/harmanpunn",
      "has": [
        {
          "type": "host",
          "value": "github.harmanpunn.me"
        }
      ],
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|_next/|favicon\\.ico|static-data/|static-loader-data-manifest-|manifestInfo\\.json|assets/|robots\\.txt|sitemap\\.xml|og-image\\.jpg|harmanpreetresume\\.pdf|placeholder\\.svg|.*\\.(?:json|js|css|map|png|jpg|jpeg|svg|webp|ico|woff2?|ttf|otf|eot|pdf|mp4|webm|xml|txt)).*)",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false
} 